---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	hypothesize(hypothesize)
	probe(probe)
	assess(assess)
	conclude(conclude)
	__end__([<p>__end__</p>]):::last
	__start__ --> hypothesize;
	assess -.-> conclude;
	assess -.-> probe;
	hypothesize --> probe;
	probe --> assess;
	conclude --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
